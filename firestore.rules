rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'faduklourencooliveira@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUserWorkspace(data) {
      return data.keys().hasAll(['uid', 'displayName', 'roleTitle', 'seeded', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'roleTitle', 'seeded', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 80
        && data.seeded is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGoal(data) {
      return data.keys().hasAll([
          'ownerId', 'code', 'title', 'pillar', 'targetValue', 'currentValue',
          'unit', 'targetMonth', 'status', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'code', 'title', 'pillar', 'targetValue', 'currentValue',
          'unit', 'targetMonth', 'status', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 24 && data.code.matches('^[A-Z0-9\\-]+$')
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
        && data.pillar in [
          'Nutrição Materno-Infantil',
          'Inclusão Produtiva & Hortas',
          'Resiliência Alimentar & VSLA',
          'Capacitação Comunitária'
        ]
        && (data.targetValue is int || data.targetValue is float) && data.targetValue > 0 && data.targetValue <= 1000000
        && (data.currentValue is int || data.currentValue is float) && data.currentValue >= 0 && data.currentValue <= 1000000
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 40
        && data.targetMonth is int && data.targetMonth >= 1 && data.targetMonth <= 12
        && data.status in ['No Prazo', 'Em Risco', 'Concluída']
        && data.notes is string && data.notes.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFamily(data) {
      return data.keys().hasAll([
          'ownerId', 'code', 'headOfHousehold', 'community', 'clubName', 'membersCount',
          'childrenUnder5', 'hasPcd', 'hasElderly', 'gardenStatus', 'dietaryDiversityImproved',
          'hasBioGarden', 'inSavingsGroup', 'multiplierName', 'nutritionStatus',
          'registrationDate', 'notes', 'enrolledMonth', 'adminValidated', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'code', 'headOfHousehold', 'community', 'clubName', 'membersCount',
          'childrenUnder5', 'hasPcd', 'hasElderly', 'gardenStatus', 'dietaryDiversityImproved',
          'hasBioGarden', 'inSavingsGroup', 'multiplierName', 'nutritionStatus',
          'registrationDate', 'notes', 'enrolledMonth', 'adminValidated', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.code is string && data.code.size() >= 3 && data.code.size() <= 24 && data.code.matches('^[A-Z0-9\\-]+$')
        && data.headOfHousehold is string && data.headOfHousehold.size() >= 2 && data.headOfHousehold.size() <= 120
        && data.community is string && data.community.size() >= 2 && data.community.size() <= 80
        && data.clubName in ['Clube 1', 'Clube 2', 'Clube 3', 'Clube 4', 'Clube 5', 'Clube 6', 'Clube 7']
        && data.membersCount is int && data.membersCount >= 1 && data.membersCount <= 40
        && data.childrenUnder5 is int && data.childrenUnder5 >= 0 && data.childrenUnder5 <= 20
        && data.hasPcd is bool
        && data.hasElderly is bool
        && data.gardenStatus in ['Planeada', 'Instalada e Funcional', 'Em Manutenção']
        && data.dietaryDiversityImproved is bool
        && data.hasBioGarden is bool
        && data.inSavingsGroup is bool
        && data.multiplierName is string && data.multiplierName.size() >= 2 && data.multiplierName.size() <= 120
        && data.nutritionStatus in ['Estável', 'Acompanhamento Prioritário', 'Graduada']
        && data.registrationDate is string && data.registrationDate.size() == 10 && data.registrationDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.notes is string && data.notes.size() <= 400
        && data.enrolledMonth is int && data.enrolledMonth >= 1 && data.enrolledMonth <= 12
        && data.adminValidated is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMultiplier(data) {
      return data.keys().hasAll([
          'ownerId', 'code', 'fullName', 'community', 'clubName', 'specialty', 'phone',
          'trainingStatus', 'homeVisitsCount', 'muacScreeningsCount', 'riskCasesReferred',
          'familiesAssigned', 'sessionsHeld', 'status', 'notes', 'adminValidated', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'code', 'fullName', 'community', 'clubName', 'specialty', 'phone',
          'trainingStatus', 'homeVisitsCount', 'muacScreeningsCount', 'riskCasesReferred',
          'familiesAssigned', 'sessionsHeld', 'status', 'notes', 'adminValidated', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.code is string && data.code.size() >= 3 && data.code.size() <= 24 && data.code.matches('^[A-Z0-9\\-]+$')
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.community is string && data.community.size() >= 2 && data.community.size() <= 80
        && data.clubName in ['Clube 1', 'Clube 2', 'Clube 3', 'Clube 4', 'Clube 5', 'Clube 6', 'Clube 7']
        && data.specialty in [
          'Nutrição Materno-Infantil',
          'Agroecologia & Hortas',
          'Poupança & Resiliência (VSLA)'
        ]
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30
        && data.trainingStatus in ['Em formação', 'Certificado']
        && data.homeVisitsCount is int && data.homeVisitsCount >= 0 && data.homeVisitsCount <= 5000
        && data.muacScreeningsCount is int && data.muacScreeningsCount >= 0 && data.muacScreeningsCount <= 5000
        && data.riskCasesReferred is int && data.riskCasesReferred >= 0 && data.riskCasesReferred <= 1000
        && data.familiesAssigned is int && data.familiesAssigned >= 0 && data.familiesAssigned <= 500
        && data.sessionsHeld is int && data.sessionsHeld >= 0 && data.sessionsHeld <= 1000
        && data.status in ['Activo', 'Em Formação', 'Inactivo']
        && data.notes is string && data.notes.size() <= 400
        && data.adminValidated is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivity(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'category', 'community', 'activityDate',
          'projectMonth', 'multiplierName', 'womenCount', 'menCount',
          'childrenCount', 'summary', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'category', 'community', 'activityDate',
          'projectMonth', 'multiplierName', 'womenCount', 'menCount',
          'childrenCount', 'summary', 'status', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
        && data.category in [
          'Demonstração Culinária',
          'Rastreio Nutricional (MUAC)',
          'Oficina de Horta Biointensiva',
          'Formação de Multiplicadores',
          'Grupo de Poupança e Resiliência'
        ]
        && data.community is string && data.community.size() >= 2 && data.community.size() <= 80
        && data.activityDate is string && data.activityDate.size() == 10 && data.activityDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.projectMonth is int && data.projectMonth >= 1 && data.projectMonth <= 12
        && data.multiplierName is string && data.multiplierName.size() >= 2 && data.multiplierName.size() <= 120
        && data.womenCount is int && data.womenCount >= 0 && data.womenCount <= 5000
        && data.menCount is int && data.menCount >= 0 && data.menCount <= 5000
        && data.childrenCount is int && data.childrenCount >= 0 && data.childrenCount <= 5000
        && data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 600
        && data.status in ['Planeado', 'Submetido', 'Validado']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReportDocument(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'docType', 'activityDate', 'community', 'projectMonth',
          'uploadedBy', 'uploadedByRole', 'fileName', 'mimeType',
          'fileSizeBytes', 'contentDataUrl', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'docType', 'activityDate', 'community', 'projectMonth',
          'uploadedBy', 'uploadedByRole', 'fileName', 'mimeType',
          'fileSizeBytes', 'contentDataUrl', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
        && data.docType in [
          'Formação Técnica',
          'Instalação de Hortas Inclusivas',
          'Alerta Nutri-SMS / Vigilância Nutricional',
          'Reunião Clube NutriFamily',
          'Lista de Presença',
          'Outro'
        ]
        && data.activityDate is string && data.activityDate.size() == 10 && data.activityDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.community is string && data.community.size() >= 2 && data.community.size() <= 80
        && data.projectMonth is int && data.projectMonth >= 1 && data.projectMonth <= 12
        && data.uploadedBy is string && data.uploadedBy.size() >= 2 && data.uploadedBy.size() <= 120
        && data.uploadedByRole in ['Gestor de Projectos', 'Administrador']
        && data.fileName is string && data.fileName.size() >= 3 && data.fileName.size() <= 160
        && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 100
        && data.fileSizeBytes is int && data.fileSizeBytes >= 1 && data.fileSizeBytes <= 500000
        && data.contentDataUrl is string && data.contentDataUrl.size() >= 10 && data.contentDataUrl.size() <= 650000
        && data.notes is string && data.notes.size() <= 600
        && data.status in ['Enviado', 'Revisto']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspace(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspace(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'roleTitle', 'seeded', 'updatedAt']);
      allow delete: if false;
    }

    match /goals/{goalId} {
      allow get: if isValidId(goalId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(goalId)
        && isValidGoal(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(goalId)
        && isValidGoal(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'title', 'pillar', 'targetValue', 'currentValue', 'unit', 'targetMonth', 'status', 'notes', 'updatedAt'])) ||
          (
            existing().ownerId == request.auth.uid
            && existing().status != 'Concluída'
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['currentValue', 'status', 'notes', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['code', 'title', 'pillar', 'targetValue', 'currentValue', 'unit', 'targetMonth', 'status', 'notes', 'updatedAt'])
            )
          )
        );
      allow delete: if isVerifiedUser() && isValidId(goalId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /families/{familyId} {
      allow get: if isValidId(familyId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(familyId)
        && isValidFamily(incoming())
        && (isAdmin() || incoming().adminValidated == false)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(familyId)
        && isValidFamily(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && incoming().adminValidated == existing().adminValidated)
        )
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['nutritionStatus', 'gardenStatus', 'hasBioGarden', 'inSavingsGroup', 'dietaryDiversityImproved', 'adminValidated', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'code', 'headOfHousehold', 'community', 'clubName', 'membersCount', 'childrenUnder5',
            'hasPcd', 'hasElderly', 'gardenStatus', 'dietaryDiversityImproved',
            'hasBioGarden', 'inSavingsGroup', 'multiplierName', 'nutritionStatus',
            'registrationDate', 'notes', 'enrolledMonth', 'adminValidated', 'updatedAt'
          ])
        );
      allow delete: if isVerifiedUser() && isValidId(familyId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /multipliers/{multiplierId} {
      allow get: if isValidId(multiplierId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(multiplierId)
        && isValidMultiplier(incoming())
        && (isAdmin() || incoming().adminValidated == false)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(multiplierId)
        && isValidMultiplier(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && incoming().adminValidated == existing().adminValidated)
        )
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['homeVisitsCount', 'muacScreeningsCount', 'riskCasesReferred', 'trainingStatus', 'familiesAssigned', 'sessionsHeld', 'status', 'notes', 'adminValidated', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'code', 'fullName', 'community', 'clubName', 'specialty', 'phone',
            'trainingStatus', 'homeVisitsCount', 'muacScreeningsCount', 'riskCasesReferred',
            'familiesAssigned', 'sessionsHeld', 'status', 'notes', 'adminValidated', 'updatedAt'
          ])
        );
      allow delete: if isVerifiedUser() && isValidId(multiplierId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /activities/{activityId} {
      allow get: if isValidId(activityId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(activityId)
        && isValidActivity(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(activityId)
        && isValidActivity(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'category', 'community', 'activityDate', 'projectMonth',
            'multiplierName', 'womenCount', 'menCount', 'childrenCount', 'summary', 'status', 'updatedAt'
          ])) ||
          (
            existing().ownerId == request.auth.uid
            && existing().status != 'Validado'
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'category', 'community', 'activityDate', 'projectMonth',
                'multiplierName', 'womenCount', 'menCount', 'childrenCount', 'summary', 'status', 'updatedAt'
              ])
            )
          )
        );
      allow delete: if isVerifiedUser() && isValidId(activityId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /documents/{docId} {
      allow get: if isValidId(docId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(docId)
        && isValidReportDocument(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(docId)
        && isValidReportDocument(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          existing().ownerId == request.auth.uid
        )
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'docType', 'activityDate', 'community', 'projectMonth', 'notes', 'status', 'updatedAt'])
        );
      allow delete: if isVerifiedUser() && isValidId(docId) && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
